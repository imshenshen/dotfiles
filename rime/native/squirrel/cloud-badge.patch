+
+// Cloud candidate metadata is deliberately outside the visible comment text.
+struct CloudCandidateBadge {
+  static func decode(_ comment: String) -> (text: String, isCloud: Bool) {
+    guard comment.hasPrefix("\u{E000}"), let end = comment.firstIndex(of: "\u{E001}"),
+          let mask = Int(comment[comment.index(after: comment.startIndex)..<end]),
+          (1...7).contains(mask) else { return (comment, false) }
+    return (String(comment[comment.index(after: end)...]), true)
+  }
+
+  static func append(to line: NSMutableAttributedString, attributes: [NSAttributedString.Key: Any]) {
+    guard let symbol = NSImage(systemSymbolName: "cloud.fill", accessibilityDescription: "云候选") else { return }
+    // A fixed small badge at the end of the candidate, below the text baseline.
+    // Palette rendering preserves vector sharpness on Retina screens.
+    let configuration = NSImage.SymbolConfiguration(pointSize: 10, weight: .regular)
+      .applying(NSImage.SymbolConfiguration(paletteColors: [NSColor.secondaryLabelColor.withAlphaComponent(0.5)]))
+    let attachment = NSTextAttachment()
+    attachment.image = symbol.withSymbolConfiguration(configuration)
+    attachment.bounds = NSRect(x: 0, y: -3, width: 12, height: 9)
+    while line.string.hasSuffix(" ") { line.deleteCharacters(in: NSRange(location: line.length - 1, length: 1)) }
+    line.append(NSAttributedString(string: "\u{2009}", attributes: attributes))
+    let badge = NSMutableAttributedString(attachment: attachment)
+    badge.addAttribute(.baselineOffset, value: 0, range: NSRange(location: 0, length: badge.length))
+    line.append(badge)
+    // Keep the icon attached to the final text fragment when a row wraps.
+    if line.length >= 2 {
+      line.addAttribute(.noBreak, value: true, range: NSRange(location: line.length - 2, length: 2))
+    }
+  }
+}
