#!/bin/bash
set -euo pipefail
app="${3:-/}/Library/Input Methods/Squirrel.app"
exe="${app}/Contents/MacOS/Squirrel"
login_user=$(/usr/bin/stat -f%Su /dev/console)
if [[ "${login_user}" != root && "${login_user}" != loginwindow ]]; then
    login_uid=$(/usr/bin/id -u "${login_user}")
    in_session() { /bin/launchctl asuser "${login_uid}" /usr/bin/sudo -u "${login_user}" "$@"; }
    # Do not change TIS state during PackageKit's replacement/registration.
    # The separate one-shot helper waits for Installer exit and the new receipt.
    if /usr/sbin/pkgutil --pkg-info im.rime.inputmethod.Squirrel >/dev/null 2>&1; then
        if ! in_session "${app}/Contents/Helpers/SourceRecovery" --prepare; then
            echo 'WARNING: input-source recovery could not be scheduled; desktop activation needs verification.' >&2
        fi
        exit 0
    fi
    # First install: schedule a post-Installer job that retries registration,
    # enables/selects the source, and opens the app's one-time setup guide.
    # Immediate attempts are best-effort because the Installer may still hold
    # the input-source database at this point.
    if ! in_session "${app}/Contents/Helpers/SourceRecovery" --prepare-first; then
        echo 'WARNING: first-install source setup could not be scheduled; the setup guide will explain manual add.' >&2
    fi
    in_session "${exe}" --register-input-source || echo 'WARNING: immediate input-source registration failed; first-install helper will retry.' >&2
    in_session "${exe}" --enable-input-source || echo 'WARNING: immediate input-source enable failed; first-install helper will retry.' >&2
fi
exit 0
