#!/bin/bash
set -euo pipefail
app="${3:-/}/Library/Input Methods/Squirrel.app"
exe="${app}/Contents/MacOS/Squirrel"
login_user=$(/usr/bin/stat -f%Su /dev/console)
if [[ "${login_user}" != root && "${login_user}" != loginwindow ]]; then
    login_uid=$(/usr/bin/id -u "${login_user}")
    in_session() { /bin/launchctl asuser "${login_uid}" /usr/bin/sudo -u "${login_user}" "$@"; }
    # Do not change TIS state during PackageKit's replacement/registration.
    # The separate one-shot helper waits for Installer exit and the new receipt.
    if /usr/sbin/pkgutil --pkg-info im.rime.inputmethod.Squirrel >/dev/null 2>&1; then
        if ! in_session "${app}/Contents/Helpers/SourceRecovery" --prepare; then
            echo 'WARNING: input-source recovery could not be scheduled; desktop activation needs verification.' >&2
        fi
        exit 0
    fi
    in_session "${exe}" --register-input-source
    in_session "${exe}" --enable-input-source
fi
exit 0
