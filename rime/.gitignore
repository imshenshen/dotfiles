.build/
__pycache__/
dist/

# Production personal data is local/OSS-managed; backups and runtime state stay local.
# The root custom_phrase.txt remains tracked intentionally as a personal backup.
/custom_phrase.txt.backup-*
/mixed_user_dictionary.json
*.userdb/
*.userdb.txt
/installation.yaml
/user.yaml
/sync/

# Signing credentials and local release configuration must never be committed.
*.p12
*.pfx
*.key
*.pem
*.certSigningRequest
/release.json
