.build/
__pycache__/
dist/

# Personal dictionaries and runtime state stay on this computer.
/custom_phrase.txt
/custom_phrase.txt.backup-*
/mixed_user_dictionary.json
*.userdb/
*.userdb.txt
/installation.yaml
/user.yaml
/sync/

# Signing credentials and local release configuration must never be committed.
*.p12
*.pfx
*.key
*.pem
*.certSigningRequest
/release.json
